---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	date: Date;
	updated?: Date;
	headings?: Heading[];
}

const { title, description, date, updated, headings = [] } = Astro.props;

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
---

<BaseLayout title={`${title} — Mark Landergan`} description={description}>
	<div class="flex items-start justify-between gap-10">
		<article class="min-w-0 max-w-[125ch] flex-1">
			<header class="mb-8 border-b border-paper-divider pb-6">
				<h1 class="font-heading text-3xl font-semibold text-ink sm:text-4xl">{title}</h1>
				<p class="mt-3 text-sm text-ink-muted">
					<time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', dateFormat)}</time>
					{
						updated && (
							<>
								{' '}
								· updated{' '}
								<time datetime={updated.toISOString()}>
									{updated.toLocaleDateString('en-US', dateFormat)}
								</time>
							</>
						)
					}
				</p>
			</header>

			<div
				id="post-content"
				class="prose prose-lg max-w-none
					prose-headings:font-heading prose-headings:font-semibold prose-headings:text-ink
					prose-p:text-ink prose-strong:text-ink prose-em:text-ink
					prose-a:text-link prose-a:no-underline hover:prose-a:text-link-hover hover:prose-a:underline
					prose-code:font-normal prose-code:text-ink prose-code:before:content-none prose-code:after:content-none
					prose-pre:bg-ink prose-pre:text-paper-bg
					prose-blockquote:border-l-link prose-blockquote:text-ink-light
					prose-hr:border-paper-divider
					prose-img:rounded-lg prose-img:cursor-zoom-in prose-th:text-ink prose-td:text-ink-light"
			>
				<slot />
			</div>
		</article>

		<TableOfContents headings={headings} />
	</div>

	<div
		id="lightbox-overlay"
		class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-black/85 p-6"
	>
		<img id="lightbox-img" src="" alt="" class="max-h-full max-w-full rounded-lg shadow-2xl" />
	</div>
</BaseLayout>

<script>
	const content = document.getElementById('post-content');
	const overlay = document.getElementById('lightbox-overlay');
	const overlayImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

	function openLightbox(img: HTMLImageElement) {
		if (!overlay || !overlayImg) return;
		overlayImg.src = img.src;
		overlayImg.alt = img.alt;
		overlay.classList.remove('hidden');
		overlay.classList.add('flex');
	}

	function closeLightbox() {
		if (!overlay) return;
		overlay.classList.add('hidden');
		overlay.classList.remove('flex');
	}

	content?.addEventListener('click', (e) => {
		const target = e.target;
		if (target instanceof HTMLImageElement) openLightbox(target);
	});

	overlay?.addEventListener('click', closeLightbox);

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeLightbox();
	});
</script>
