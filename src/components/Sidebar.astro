---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Writing' },
];
const currentPath = Astro.url.pathname;
---

<aside
	class="flex h-full flex-col px-6 py-8 sm:py-12 lg:sticky lg:top-0 lg:h-screen lg:w-[215px] lg:shrink-0 lg:self-start lg:border-r lg:border-paper-divider"
>
	<a href="/" class="font-heading text-lg font-semibold text-ink no-underline">
		Mark Landergan
	</a>
	<p class="mt-2 text-sm text-ink-light">Robotics &amp; RL notes.</p>

	<nav class="mt-8 flex flex-col gap-1 text-sm">
		{
			navItems.map((item) => {
				const isActive =
					item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
				return (
					<a
						href={item.href}
						class:list={[
							'rounded-md px-2 py-1.5 no-underline transition-colors',
							isActive
								? 'bg-ink/5 text-ink font-medium'
								: 'text-ink-light hover:bg-ink/5 hover:text-ink',
						]}
					>
						{item.label}
					</a>
				);
			})
		}
	</nav>

	<div class="mt-auto pt-8 text-xs text-ink-muted">
		<a href="https://github.com/mlandergan" class="text-ink-muted hover:text-ink">GitHub</a>
	</div>
</aside>
