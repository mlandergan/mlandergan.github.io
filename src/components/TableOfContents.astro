---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<div class="hidden self-start xl:sticky xl:top-12 xl:block xl:w-[180px] xl:shrink-0">
			<nav aria-label="Table of contents">
				<p class="mb-2 text-xs font-heading font-semibold tracking-wide uppercase text-ink-muted">
					On this page
				</p>
				<ol class="space-y-2 text-sm">
					{items.map((heading) => (
						<li class:list={[heading.depth === 3 && 'pl-3']}>
							<a
								href={`#${heading.slug}`}
								class="text-ink-light no-underline decoration-current underline-offset-2 transition-colors hover:text-ink hover:underline"
							>
								{heading.text}
							</a>
						</li>
					))}
				</ol>
			</nav>
		</div>
	)
}
